# 自动将文本文件的行尾转换为LF，确保跨平台兼容性
* text=auto

# Python文件
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# 配置文件
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.env.example text eol=lf

# 脚本文件
*.sh text eol=lf
*.bash text eol=lf

# 文档
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# Web文件
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# 二进制文件
*.pth binary
*.h5 binary
*.pb binary
*.onnx binary
*.pyd binary
*.dll binary
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.npy binary
*.db binary
*.sqlite binary